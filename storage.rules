rules_version = '2';

// Storage layout: products/, categories/, parties/, logos/, documents/
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn()
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
           in ['admin', 'super_admin', 'manager'];
    }

    // Everyone signed in can read catalog imagery; only admins can write.
    match /{folder}/{allPaths=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
